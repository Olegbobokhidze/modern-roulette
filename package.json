{
  "name": "modern-roulette",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Modern minimalist European roulette: decoupled betting engine, dual-motion wheel and ball renderer, React UI and provider inspector.",
  "author": "Oleg Bobokhidze",
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "e2e": "node e2e/smoke.mjs",
    "log:decision": "node scripts/log-decision.mjs",
    "report:new": "node scripts/new-report.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "puppeteer-core": "23.11.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] }
}
